<Project Sdk="Aspire.AppHost.Sdk/13.5.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>d7edc85a-ed21-443c-b2d3-f5c4ec8abdc3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\database\live\**\*.sql">
      <Link>database\live\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\main\LifeInsuranceCRM.API.csproj" />
  </ItemGroup>

</Project>
