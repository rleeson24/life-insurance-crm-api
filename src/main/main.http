# LifeInsuranceCRM.API — local requests
# Standalone: dotnet run --project main/LifeInsuranceCRM.API.csproj (https profile → port 7114)
# Aspire: use the API endpoint URL from the Aspire dashboard (port varies)

@main_HostAddress = https://localhost:7114

### Health — readiness
GET {{main_HostAddress}}/health
Accept: application/json

### Health — liveness
GET {{main_HostAddress}}/alive
Accept: application/json

### Status — anonymous
GET {{main_HostAddress}}/api/status
Accept: application/json

### Status — authenticated
GET {{main_HostAddress}}/api/status/authenticated
Accept: application/json

### List clients
GET {{main_HostAddress}}/api/clients?page=1&pageSize=25
Accept: application/json

### Search clients
GET {{main_HostAddress}}/api/clients?search=Jane&isActive=true
Accept: application/json

### Get client
GET {{main_HostAddress}}/api/clients/33333333-3333-3333-3333-333333333333
Accept: application/json

### Get client detail (profile shell)
GET {{main_HostAddress}}/api/clients/33333333-3333-3333-3333-333333333333/detail
Accept: application/json

### Create client
POST {{main_HostAddress}}/api/clients
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "isActive": true
}

### Update client
PUT {{main_HostAddress}}/api/clients/33333333-3333-3333-3333-333333333333
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Smith",
  "isActive": true,
  "isAcaClient": false,
  "hasContactConsent": true
}

### Patch client status
PATCH {{main_HostAddress}}/api/clients/33333333-3333-3333-3333-333333333333
Content-Type: application/json

{
  "isActive": false
}

### List interactions
GET {{main_HostAddress}}/api/clients/33333333-3333-3333-3333-333333333333/interactions
Accept: application/json

### List follow-ups
GET {{main_HostAddress}}/api/follow-ups
Accept: application/json

### Current user
GET {{main_HostAddress}}/api/me
Accept: application/json

### List organization users (Admin or SuperAdmin)
GET {{main_HostAddress}}/api/organization-users
Accept: application/json

### List organization users in one tenant (SuperAdmin)
GET {{main_HostAddress}}/api/organization-users?tenantId=22222222-2222-2222-2222-222222222222
Accept: application/json

### Create organization user
POST {{main_HostAddress}}/api/organization-users
Content-Type: application/json

{
  "userId": "e1da25de-af92-4e5c-a9ac-1bc186bb9a4f",
  "emailAddress": "user@example.com",
  "displayName": "New User",
  "role": "Agent",
  "tenantId": "22222222-2222-2222-2222-222222222222"
}

### Update organization user
PATCH {{main_HostAddress}}/api/organization-users/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
Content-Type: application/json

{
  "emailAddress": "user@example.com",
  "displayName": "New User",
  "role": "Agent",
  "isActive": true
}

### List tenants (SuperAdmin)
GET {{main_HostAddress}}/api/tenants
Accept: application/json

### Create tenant (SuperAdmin)
POST {{main_HostAddress}}/api/tenants
Content-Type: application/json

{
  "name": "North Agency"
}

### Deactivate tenant (SuperAdmin)
PATCH {{main_HostAddress}}/api/tenants/22222222-2222-2222-2222-222222222222
Content-Type: application/json

{
  "isActive": false
}

### OpenAPI document (Development only)
GET {{main_HostAddress}}/openapi/v1.json
Accept: application/json
