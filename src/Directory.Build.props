<Project>
  <PropertyGroup>
    <!-- Surface known-vulnerable packages on restore (direct and transitive). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- SqlClient and Identity.Web still request Pkcs 9.0.18 / 10.0.10.
         A direct reference forces 10.0.13 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
